# Auth tokens for the MCP service (comma-separated)
MCP_TOKENS=8TikTAffQT3Db65Q7xbofbUjapGjKepTI3sikOeLWClfXW5GXO

# Require auth on all endpoints (true/false)
MCP_REQUIRE_AUTH=false

# Allow tokens via URL/query in addition to Authorization header
MCP_ALLOW_URL_TOKENS=true

# Optional base URL used when returning clickable asset links
MCP_PUBLIC_BASE_URL=https://rtlm.info
# Token to append as ?token=... in asset URLs (requires MCP_ALLOW_URL_TOKENS=true)
MCP_PUBLIC_LINK_TOKEN=8TikTAffQT3Db65Q7xbofbUjapGjKepTI3sikOeLWClfXW5GXO
# Override if assets are served from a dedicated host (leave empty to derive from base URL)
MCP_PUBLIC_ASSET_BASE_URL=
